# NOTE: actors/*/src/govkit/ is deliberately NOT ignored.
#
# `apify push` excludes anything matched by .gitignore. Ignoring the vendored
# copies meant every actor was uploaded with its own core library stripped out.
# So the copies are committed instead, and CI runs `build_actor.py` and fails on
# any diff - drift is caught by the pipeline rather than prevented by omission.
# src/govkit remains the single source of truth; never hand-edit a copy.

.venv/

# Apify CLI local state
actors/*/storage/
actors/*/.venv/
apify_storage/
storage/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

.env
.env.*
!.env.example

.vscode/
.idea/
.DS_Store
