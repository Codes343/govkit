# The Dockerfile does `COPY . ./`, so anything not excluded here is uploaded to
# Apify and baked into the image. Keep the build small and free of local junk.
.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
storage
apify_storage
crawlee_storage
.DS_Store
